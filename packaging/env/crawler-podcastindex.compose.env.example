# Docker Compose env for the one-shot `podcastindex` service.
# `/data` is the crawler state volume inside the container.
# These values are consumed by the compose command wrapper, which turns them
# into `stophammer-crawler podcastindex ...` flags.

CRAWL_TOKEN=change-me
INGEST_URL=http://primary:8008/ingest/feed

# PodcastIndex API credentials (ADR 0081 §2).
# Put the real values only in the local `crawler-podcastindex.compose.env`.
# That file stays outside Git.
PODCASTINDEX_API_KEY=change-me
PODCASTINDEX_API_SECRET=change-me

IMPORT_STATE_DB=/data/import_state.db
FEED_SKIP_DB=/data/feed_skip.db
FEED_CACHE_DB=/data/feed_cache.db
# FAILED_FEEDS_OUTPUT=/data/failed_feeds.txt
# NO_REVALIDATE=1

CONCURRENCY=5
HOST_DELAY_MS=1500

# Optional pass behavior
# Set PODCASTINDEX_DRY_RUN=1 for the first run. The pass sends no URL.
# PODCASTINDEX_DRY_RUN=1
# FORCE_REINGEST=0
# Use PODCASTINDEX_API_BASE only with a local test server.
# PODCASTINDEX_API_BASE=https://api.podcastindex.org/api/1.0

# Optional image override in the project environment or top-level `.env`:
# STOPHAMMER_CRAWLER_IMAGE=stophammer-crawler
