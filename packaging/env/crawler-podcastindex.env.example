# Example environment for one-shot podcastindex runs

# Required
# CRAWL_TOKEN=change-me
# INGEST_URL=http://localhost:8008/ingest/feed

# PodcastIndex API credentials (ADR 0081 §2).
# Put the real values only in /etc/stophammer/crawler-podcastindex.env.
# That file stays outside Git.
PODCASTINDEX_API_KEY=change-me
PODCASTINDEX_API_SECRET=change-me

# State
# IMPORT_STATE_DB=/var/lib/stophammer-crawler/import_state.db
# FEED_SKIP_DB=/var/lib/stophammer-crawler/feed_skip.db
# FEED_CACHE_DB=/var/lib/stophammer-crawler/feed_cache.db
# FAILED_FEEDS_OUTPUT=/var/lib/stophammer-crawler/failed_feeds.txt

CONCURRENCY=5
HOST_DELAY_MS=1500

# Optional pass behavior
# Set PODCASTINDEX_DRY_RUN=1 for the first run. The pass sends no URL.
# PODCASTINDEX_DRY_RUN=1
# FORCE_REINGEST=0
# NO_REVALIDATE=0
# PODCASTINDEX_API_BASE=https://api.podcastindex.org/api/1.0
