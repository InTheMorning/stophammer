# MusicIndex live metadata relay.
#
# Upstream: https://github.com/InTheMorning/Live-Metadata-Relay
# Deployed by ../../deploy-live-relay.sh, published on the host loopback at
# 127.0.0.1:8018 for the nginx /v1/liveitems/* location to proxy to.
#
# All relay state is in memory. Restarting the container drops every live item,
# broadcaster token, latest snapshot, and replay buffer, so every broadcaster
# must re-provision after a restart.

# Bind inside the container. Compose maps this to 127.0.0.1:8018 on the host.
BIND=0.0.0.0:8018

# Maximum live items held in memory.
MAX_ACTIVE_EVENTS=10000

# Maximum concurrent SSE streams.
MAX_SSE_CONNECTIONS=1000

# Time before an inactive live item expires. 86400 = 24h.
EVENT_TTL_SECS=86400

# Global cap on POST /v1/liveitems per second; excess gets HTTP 429.
# This is a safety bound, not a per-client limit — do per-IP limiting in nginx.
MAX_CREATES_PER_SEC=50

# Per-event cap on metadata publishes per second; excess gets HTTP 429.
MAX_PUBLISHES_PER_EVENT_PER_SEC=20
