# Minimal runtime image — expects pre-built musl binaries in the build context.
# Used by deploy.sh for fast local-build → ship workflow.

FROM alpine:3.20 AS stophammer-runtime

RUN apk add --no-cache ca-certificates \
 && addgroup -S stophammer \
 && adduser -S -G stophammer stophammer \
 && mkdir -p /data \
 && chown stophammer:stophammer /data

WORKDIR /data
COPY stophammer /usr/local/bin/stophammer
COPY gen_openapi /usr/local/bin/gen_openapi

USER stophammer

ENV DB_PATH=/data/stophammer.db
ENV KEY_PATH=/data/signing.key
ENV BIND=0.0.0.0:8008

EXPOSE 8008

FROM stophammer-runtime AS stophammer-indexer
CMD ["stophammer"]

FROM stophammer-runtime AS stophammer-node
ENV NODE_MODE=community
CMD ["stophammer"]

# --- MusicIndex live metadata relay -----------------------------------------
# Independent of the stophammer-runtime stages above: it copies a different
# binary, so `--target stophammer-indexer` never needs the relay in its build
# context, and vice versa.
#
# Source: https://github.com/InTheMorning/Live-Metadata-Relay
# Built locally as a static musl binary by deploy-live-relay.sh.

FROM alpine:3.20 AS musicindex-live-relay

RUN apk add --no-cache ca-certificates \
 && addgroup -S relay \
 && adduser -S -G relay relay

COPY musicindex-live-relay /usr/local/bin/musicindex-live-relay

USER relay

# Bind all interfaces inside the container; Compose publishes it on the host
# loopback only, so nginx can reach it and the outside world cannot.
ENV BIND=0.0.0.0:8018

EXPOSE 8018

CMD ["musicindex-live-relay"]
