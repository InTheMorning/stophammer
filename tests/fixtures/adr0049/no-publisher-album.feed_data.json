      "transcripts": [],
      "remote_items": []
    },
    {
      "track_guid": "https://justcast.com/shows/44720/audioposts/1245719",
      "title": "Upstate",
      "pub_date": 1646837135,
      "duration_secs": 296,
      "image_url": "https://backend-api.justcast.com/media_files/af82WVYJcebgH1dNhTJYciec.jpeg",
      "language": "en",
      "enclosure_url": "https://backend-api.justcast.com/public_feeds/into-the-blue/episodes/1245719.mp3",
      "enclosure_type": "audio/mpeg",
      "enclosure_bytes": 7107932,
      "alternate_enclosures": [],
      "track_number": 3,
      "season": 1,
      "explicit": false,
      "description": "“Upstate” was written while living in Oneonta, New York, after a visit to Brazil. I’m working on a book on Brazilian piano styles with Alfredo Cardim, who reminds me that samba should be played in cut time, with the bass player imitating the surdo part, with the first beat a bit muffled and the second beat louder. I gave in to the impulse to add sixteenth notes to the bass part on the bridge.",
      "author_name": null,
      "persons": [],
      "entity_ids": [],
      "links": [
        {
          "position": 0,
          "link_type": "web_page",
          "url": "https://justcast.com/shows/44720/audioposts/1245719",
          "extraction_path": "entity.link"
        }
      ],
      "payment_routes": [],
      "value_time_splits": [],
      "transcripts": [],
      "remote_items": []
    },
    {
      "track_guid": "https://justcast.com/shows/44720/audioposts/1245720",
      "title": "Into the Blue",
      "pub_date": 1646837175,
      "duration_secs": 219,
      "image_url": "https://backend-api.justcast.com/media_files/BNMQpa9KcWVLLJE3EXtf1ik8.jpeg",
      "language": "en",
      "enclosure_url": "https://backend-api.justcast.com/public_feeds/into-the-blue/episodes/1245720.mp3",
      "enclosure_type": "audio/mpeg",
      "enclosure_bytes": 5271634,
      "alternate_enclosures": [],
      "track_number": 4,
      "season": 1,
      "explicit": false,
      "description": "The impetus for changing the name from the original “Little Fox” to “Into the Blue” came from realizing its similarity with an earlier composition, “Out of the Blue.” I suppose the impulse for the chord progression comes from Pachebel’s “Canon in D”.",
