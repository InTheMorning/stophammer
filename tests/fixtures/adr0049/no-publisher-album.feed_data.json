      "transcripts": [],
      "remote_items": []
    },
    {
      "track_guid": "https://justcast.com/shows/44720/audioposts/1245718",
      "title": "for the Time Being",
      "pub_date": 1646837040,
      "duration_secs": 414,
      "image_url": "https://backend-api.justcast.com/media_files/NhzR5EGCMDRQEug1n2oRzFi3.jpeg",
      "language": "en",
      "enclosure_url": "https://backend-api.justcast.com/public_feeds/into-the-blue/episodes/1245718.mp3",
      "enclosure_type": "audio/mpeg",
      "enclosure_bytes": 9961768,
      "alternate_enclosures": [],
      "track_number": 2,
      "season": 1,
      "explicit": false,
      "description": "“for the Time Being” is dedicated to the giver of the moments we have to explore life. The metallic balls of János Négyesy’s clock heard at the beginning and end of the song were recorded by Josef Kucera for one of our projects at U.C. San Diego sometime in the 1980’s.",
      "author_name": null,
      "persons": [],
      "entity_ids": [],
      "links": [
        {
          "position": 0,
          "link_type": "web_page",
          "url": "https://justcast.com/shows/44720/audioposts/1245718",
          "extraction_path": "entity.link"
        }
      ],
