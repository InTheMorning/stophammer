# Copy this file to deploy.env. Git ignores deploy.env.
# deploy.sh, deploy-live-relay.sh and deploy-podping-listener.sh read it.
# A value in the environment has priority over this file.

# The SSH target of the VPS.
VPS=user@vps.example.org
# The Stophammer folder on the VPS.
VPS_DIR=/srv/stophammer
# The public address of the primary. deploy.sh --release checks /node/info there,
# and deploy-live-relay.sh checks its health route there.
NODE_URL=https://node.example.org
# Optional. The image registry path. The default comes from the owner of the
# origin remote.
#GHCR_PREFIX=ghcr.io/example
